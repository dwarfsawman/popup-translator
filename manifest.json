{
  "manifest_version": 3,
  "name": "OpenRouter Inline Translator",
  "version": "1.8",
  "description": "Translate selected text on the page using OpenRouter API. Configure API key in options.",
  "permissions": ["storage", "scripting", "contextMenus"],
  "host_permissions": ["https://openrouter.ai/"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "options_page": "options.html"
}
