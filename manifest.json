{
  "manifest_version": 3,
  "name": "OpenAI Inline Translator",
  "version": "1.2", // バージョンアップ
  "description": "Translate selected text on the page using OpenAI API. Configure API key in options.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://api.openai.com/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true
    }
  ],
  "options_page": "options.html"
  
}